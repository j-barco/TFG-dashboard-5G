# Copia este fichero a ".env" y ajusta los valores.

# --- Autenticación ---
# Activada por defecto. Poner a "false" solo en uso individual/laboratorio
# aislado -- ver Metodología del TFG (fail-safe defaults).
AUTH_ENABLED=true
JWT_SECRET_KEY=cambia-esto-por-una-clave-aleatoria-larga
ADMIN_USERNAME=admin
# Genera un hash nuevo para tu propia contraseña con:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'tu_contraseña', bcrypt.gensalt()).decode())"
# El valor de abajo corresponde a la contraseña de ejemplo "admin" -- cámbiala antes de cualquier uso real.
ADMIN_PASSWORD_HASH=$2b$12$9mp6BL2wDk4NiqKyAkuqz.pu4Z0pAd0eXEtcb49YX7Iy4VivHdHxO

# --- Open5GS (Docker) ---
# El host donde corren los contenedores. El puerto de cada NF se define en
# app/config.py (nf_metrics_ports) -- no hace falta tocarlo aquí salvo que
# cambies los puertos publicados en tu docker-compose.yaml.
OPEN5GS_HOST=localhost
# IP interna fija del NRF en la red de Docker (ver docker-compose.yaml,
# IPs internas fijas) -- su puerto SBI no está publicado hacia el host,
# se consulta directamente por la red bridge de Docker.
NRF_SBI_URL=http://10.33.33.3:80

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=open5gs

# --- Control del gNB ---
# Rutas absolutas en TU equipo. Deben coincidir con las reglas sudoers
# (ver README) y con GNB_BIN en deployment.conf.
GNB_CTL_SCRIPT=/path/to/dashboard-backend/scripts/gnb_ctl.sh
GNB_CONFIG_PATH=/path/to/srsRAN_Project/build/apps/gnb/gnb_config.yml

# --- Control del core en Docker ---
# La ruta del docker-compose.yaml/.env vive dentro del propio script
# docker_ctl.sh (igual que la del gNB en gnb_ctl.sh), no aquí.
DOCKER_CTL_SCRIPT=/path/to/dashboard-backend/scripts/docker_ctl.sh
